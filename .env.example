# Starcall configuration. Copy to .env and fill in what you have; everything is optional.
# Without any keys the app runs in a clearly labelled demo mode (scripted replies, browser voices).

# --- Server -------------------------------------------------------------------------------
PORT=8787
# Public URL (used for Stripe redirects and secure cookies when https)
PUBLIC_URL=http://localhost:5173
# Random string used to sign session cookies (set this in production!)
SESSION_SECRET=
# Enables the /admin console and /api/admin endpoints
ADMIN_TOKEN=
DATA_DIR=./data

# --- Conversational AI (Claude) ------------------------------------------------------------
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5; override if you want a different model.
# LLM_MODEL=claude-opus-5-5
# LLM_UTILITY_MODEL=            # captions translation + greeting scripts (defaults to LLM_MODEL)
# LLM_FALLBACKS=off             # disable server-side refusal fallbacks

# --- Speech (optional; browsers' built-in speech is used otherwise) ------------------------
# OpenAI: neural TTS (gpt-4o-mini-tts stock voices), speech-to-text and moderation
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_MODERATION=off
# ElevenLabs stock voices (never clones). Comma-separated voice ids to override the pools.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_VOICES_MALE=
# ELEVENLABS_VOICES_FEMALE=
# Deepgram speech-to-text
DEEPGRAM_API_KEY=
# Preferred server TTS when several are configured: elevenlabs | openai
TTS_PROVIDER=

# --- Licensed photoreal avatars (only for characters with a licensed likeness) --------------
DID_API_KEY=

# --- Payments (Stripe Checkout) -----------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Daily limits ---------------------------------------------------------------------------
# FREE_CALL_SECONDS=900
# FREE_MESSAGES=60
# FREE_GROUP_CALLS=3
# FREE_GREETINGS=2
# PREMIUM_CALL_SECONDS=21600
# PREMIUM_MESSAGES=2000
# PREMIUM_GROUP_CALLS=100
# PREMIUM_GREETINGS=50
