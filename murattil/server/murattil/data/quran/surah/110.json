{"n":110,"ayahs":[{"a":1,"text":"إِذَا جَآءَ نَصۡرُ ٱللَّهِ وَٱلۡفَتۡحُ","tokens":[{"t":"إِذَا","s":0,"w":1},{"t":"جَآءَ","s":6,"w":2},{"t":"نَصۡرُ","s":13,"w":3},{"t":"ٱللَّهِ","s":20,"w":4},{"t":"وَٱلۡفَتۡحُ","s":28,"w":5}],"page":603,"juz":30,"tj":[[2,5,30],[6,12,28],[6,10,30],[15,17,50],[17,19,41],[21,25,34]]},{"a":2,"text":"وَرَأَيۡتَ ٱلنَّاسَ يَدۡخُلُونَ فِي دِينِ ٱللَّهِ أَفۡوَاجࣰا","tokens":[{"t":"وَرَأَيۡتَ","s":0,"w":1},{"t":"ٱلنَّاسَ","s":11,"w":2},{"t":"يَدۡخُلُونَ","s":20,"w":3},{"t":"فِي","s":32,"w":4},{"t":"دِينِ","s":36,"w":5},{"t":"ٱللَّهِ","s":42,"w":6},{"t":"أَفۡوَاجࣰا","s":50,"w":7}],"page":603,"juz":30,"tj":[[2,4,41],[4,8,21],[13,17,30],[13,16,36],[22,26,39],[24,26,47],[24,26,48],[26,29,30],[32,35,30],[36,39,30],[43,47,34],[54,57,30],[57,60,23]]},{"a":3,"text":"فَسَبِّحۡ بِحَمۡدِ رَبِّكَ وَٱسۡتَغۡفِرۡهُۚ إِنَّهُۥ كَانَ تَوَّابَۢا","tokens":[{"t":"فَسَبِّحۡ","s":0,"w":1},{"t":"بِحَمۡدِ","s":10,"w":2},{"t":"رَبِّكَ","s":19,"w":3},{"t":"وَٱسۡتَغۡفِرۡهُۚ","s":27,"w":4},{"t":"إِنَّهُۥ","s":44,"w":5},{"t":"كَانَ","s":53,"w":6},{"t":"تَوَّابَۢا","s":59,"w":7}],"page":603,"juz":30,"tj":[[14,18,19],[19,21,41],[34,36,50],[46,49,36],[49,52,29],[53,56,30],[61,65,30],[65,69,23]]}]}