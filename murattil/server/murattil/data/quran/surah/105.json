{"n":105,"ayahs":[{"a":1,"text":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ","tokens":[{"t":"أَلَمۡ","s":0,"w":1},{"t":"تَرَ","s":7,"w":2},{"t":"كَيۡفَ","s":12,"w":3},{"t":"فَعَلَ","s":19,"w":4},{"t":"رَبُّكَ","s":26,"w":5},{"t":"بِأَصۡحَٰبِ","s":34,"w":6},{"t":"ٱلۡفِيلِ","s":46,"w":7}],"page":601,"juz":30,"tj":[[4,9,19],[9,11,41],[12,16,21],[26,28,41],[38,40,50],[40,43,30],[49,52,30]]},{"a":2,"text":"أَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِي تَضۡلِيلࣲ","tokens":[{"t":"أَلَمۡ","s":0,"w":1},{"t":"يَجۡعَلۡ","s":7,"w":2},{"t":"كَيۡدَهُمۡ","s":16,"w":3},{"t":"فِي","s":27,"w":4},{"t":"تَضۡلِيلࣲ","s":31,"w":5}],"page":601,"juz":30,"tj":[[4,9,19],[9,13,39],[16,20,21],[24,29,19],[27,30,30],[33,35,50],[35,38,30]]},{"a":3,"text":"وَأَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا أَبَابِيلَ","tokens":[{"t":"وَأَرۡسَلَ","s":0,"w":1},{"t":"عَلَيۡهِمۡ","s":11,"w":2},{"t":"طَيۡرًا","s":22,"w":3},{"t":"أَبَابِيلَ","s":30,"w":4}],"page":601,"juz":30,"tj":[[2,6,41],[13,17,21],[19,24,19],[22,26,21],[22,24,46],[26,32,17],[26,29,23],[32,35,30],[35,38,30]]},{"a":4,"text":"تَرۡمِيهِم بِحِجَارَةࣲ مِّن سِجِّيلࣲ","tokens":[{"t":"تَرۡمِيهِم","s":0,"w":1},{"t":"بِحِجَارَةࣲ","s":11,"w":2},{"t":"مِّن","s":23,"w":3},{"t":"سِجِّيلࣲ","s":28,"w":4}],"page":601,"juz":30,"tj":[[0,4,41],[4,7,30],[9,13,13],[9,13,33],[15,18,30],[18,20,41],[20,26,1],[20,26,5],[23,26,31],[26,30,10],[26,30,11],[30,34,30]]},{"a":5,"text":"فَجَعَلَهُمۡ كَعَصۡفࣲ مَّأۡكُولِۭ","tokens":[{"t":"فَجَعَلَهُمۡ","s":0,"w":1},{"t":"كَعَصۡفࣲ","s":13,"w":2},{"t":"مَّأۡكُولِۭ","s":22,"w":3}],"page":601,"juz":30,"tj":[[10,15,19],[17,19,50],[19,25,1],[19,25,5],[22,25,31],[27,30,30]]}]}