{"n":97,"ayahs":[{"a":1,"text":"إِنَّآ أَنزَلۡنَٰهُ فِي لَيۡلَةِ ٱلۡقَدۡرِ","tokens":[{"t":"إِنَّآ","s":0,"w":1},{"t":"أَنزَلۡنَٰهُ","s":8,"w":2},{"t":"فِي","s":21,"w":3},{"t":"لَيۡلَةِ","s":25,"w":4},{"t":"ٱلۡقَدۡرِ","s":34,"w":5}],"page":598,"juz":30,"tj":[[2,10,27],[2,7,30],[2,5,36],[10,13,10],[10,13,11],[15,18,30],[21,24,30],[25,29,21],[37,39,46],[39,43,39],[41,43,42]]},{"a":2,"text":"وَمَآ أَدۡرَىٰكَ مَا لَيۡلَةُ ٱلۡقَدۡرِ","tokens":[{"t":"وَمَآ","s":0,"w":1},{"t":"أَدۡرَىٰكَ","s":7,"w":2},{"t":"مَا","s":18,"w":3},{"t":"لَيۡلَةُ","s":22,"w":4},{"t":"ٱلۡقَدۡرِ","s":31,"w":5}],"page":598,"juz":30,"tj":[[2,6,30],[9,13,39],[11,15,30],[11,13,41],[18,21,30],[22,26,21],[34,36,46],[36,40,39],[38,40,42]]},{"a":3,"text":"لَيۡلَةُ ٱلۡقَدۡرِ خَيۡرࣱ مِّنۡ أَلۡفِ شَهۡرࣲ","tokens":[{"t":"لَيۡلَةُ","s":0,"w":1},{"t":"ٱلۡقَدۡرِ","s":9,"w":2},{"t":"خَيۡرࣱ","s":19,"w":3},{"t":"مِّنۡ","s":26,"w":4},{"t":"أَلۡفِ","s":32,"w":5},{"t":"شَهۡرࣲ","s":39,"w":6}],"page":598,"juz":30,"tj":[[0,4,21],[12,14,46],[14,18,39],[16,18,42],[19,23,21],[19,21,46],[23,29,1],[23,29,5],[26,29,31],[29,34,16]]},{"a":4,"text":"تَنَزَّلُ ٱلۡمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذۡنِ رَبِّهِم مِّن كُلِّ أَمۡرࣲ","tokens":[{"t":"تَنَزَّلُ","s":0,"w":1},{"t":"ٱلۡمَلَٰٓئِكَةُ","s":10,"w":2},{"t":"وَٱلرُّوحُ","s":26,"w":3},{"t":"فِيهَا","s":37,"w":4},{"t":"بِإِذۡنِ","s":44,"w":5},{"t":"رَبِّهِم","s":53,"w":6},{"t":"مِّن","s":62,"w":7},{"t":"كُلِّ","s":67,"w":8},{"t":"أَمۡرࣲ","s":73,"w":9}],"page":598,"juz":30,"tj":[[15,21,28],[15,19,30],[30,34,30],[30,33,41],[37,40,30],[40,43,30],[53,55,41],[60,65,8],[60,65,34],[62,65,31],[65,69,10],[65,69,11],[75,79,19]]},{"a":5,"text":"سَلَٰمٌ هِيَ حَتَّىٰ مَطۡلَعِ ٱلۡفَجۡرِ","tokens":[{"t":"سَلَٰمٌ","s":0,"w":1},{"t":"هِيَ","s":8,"w":2},{"t":"حَتَّىٰ","s":13,"w":3},{"t":"مَطۡلَعِ","s":21,"w":4},{"t":"ٱلۡفَجۡرِ","s":30,"w":5}],"page":598,"juz":30,"tj":[[2,5,30],[5,10,17],[15,20,30],[23,27,39],[23,25,50],[35,39,39],[37,39,42]]}]}